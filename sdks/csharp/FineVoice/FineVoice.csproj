<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FineVoice</PackageId>
    <Version>0.1.3</Version>
    <Authors>FineVoice</Authors>
    <Description>C# SDK for the FineVoice API: text to speech, voice conversion, music generation, audio enhancement, and more.</Description>
    <PackageTags>finevoice;tts;text-to-speech;voice;audio;music;ai;sdk</PackageTags>
    <PackageProjectUrl>https://api.finevoice.ai</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
